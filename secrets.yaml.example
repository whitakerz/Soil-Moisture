# Copy to secrets.yaml (next to NewSensor.yaml) and fill in real values.
# secrets.yaml is never committed.

wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Home Assistant native API encryption key (32-byte base64).
# Generate one at https://esphome.io/components/api.html#configuration-variables
planter20api: "REPLACE_WITH_BASE64_KEY"

# Over-the-air update password.
ota_code: "REPLACE_WITH_OTA_PASSWORD"
